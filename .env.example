# Frontend Environment Variables

# Supabase Edge Functions URL (REQUIRED)
# Replace YOUR_PROJECT_REF with your Supabase project reference ID
VITE_SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# Supabase Anon Key (REQUIRED) - Found in Supabase Dashboard > Settings > API > Project API keys
# Without this, all Edge Function calls will return HTTP 401 Unauthorized
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
